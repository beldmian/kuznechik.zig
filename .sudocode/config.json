{
  "version": "0.1.18",
  "worktree": {
    "worktreeStoragePath": ".sudocode/worktrees",
    "autoCreateBranches": true,
    "autoDeleteBranches": false,
    "enableSparseCheckout": false,
    "branchPrefix": "sudocode",
    "cleanupOrphanedWorktreesOnStartup": false
  },
  "editor": {
    "editorType": "vs-code"
  },
  "integrations": {
    "beads": {
      "enabled": false,
      "auto_sync": false,
      "options": {
        "path": ".beads",
        "issue_prefix": "i"
      },
      "default_sync_direction": "bidirectional"
    },
    "openspec": {
      "enabled": true,
      "auto_sync": true,
      "options": {
        "path": "openspec",
        "spec_prefix": "os",
        "issue_prefix": "osi"
      }
    }
  }
}
